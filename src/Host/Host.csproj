<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.22621.38</WindowsSdkPackageVersion>
    <RootNamespace>Host</RootNamespace>
    <!--
      产物名为「鼠标键盘辅助.exe」（设计文档 §1.4 / §2.2）。
      Launcher 按此名在同级目录查找宿主，两侧必须一致。
      注意：不设 AssemblyName 时默认取项目名（Host），与文档不符。
    -->
    <AssemblyName>鼠标键盘辅助</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <!--
      平台目标必须显式对齐 x64：
      仅靠 <Platforms>x64</Platforms> 只限制“可选平台”，不决定“本次构建的平台”；
      解决方案级构建下 PlatformTarget 仍可能落到 AnyCPU/x86，与下面写死的
      RuntimeIdentifier=win-x64 冲突，报 NETSDK1032。
    -->
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- 非打包分发（设计文档 §1.4）：不生成 MSIX，不注册包标识，宿主单文件自包含发布 -->
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      EnableMsixTooling 保持 true，与“非打包”并不矛盾：
      它保留的是 MSIX 工具链（用于生成 resources.pri 等资源索引），
      单文件发布（PublishSingleFile）强制要求它（WindowsAppSDK.SingleFile.targets）。
      “非打包”由 WindowsPackageType=None 决定，而非此开关。
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!--
      单文件发布下，Windows App SDK 需要在程序入口前设置
      MICROSOFT_WINDOWSAPPRUNTIME_BASE_DIRECTORY。
      本开关让 SDK 自动注入这段初始化，无需手写 Main
      （WinUI 模板用的是 XamlGeneratedMain，没有可插手的入口）。
      依据：WindowsAppSDK.SingleFile.targets 第 50-53 行。
    -->
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 单文件下 Dll 同目录重定向所需；targets 有同名默认值，此处显式声明避免依赖隐式默认 -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- 单文件发布下禁止裁剪：XAML/WinRT 大量依赖反射，裁剪会导致运行时缺类型（实测前的保守设定） -->
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      exe 文件图标（资源管理器 / 任务栏所见，需求：① 任务栏图标 + ③ exe 文件图标）。

      ApplicationIcon 是**纯编译期**属性（写进 PE 的 RT_ICON / RT_GROUP_ICON 资源），
      不参与 publish 的复制管线——因此这里指向 Assets 目录**不会**重蹈下方注释所述的
      三重纳入冲突：那条链路的成员是「None 通配 / Content 通配 / 显式 Content 复制项」，
      ApplicationIcon 不在其中，既不进 ResolvedFileToPublish，也不改任何一项的元数据。

      图标唯一源：Assets\AppIcon.ico（与 MainWindow / TrayIcon 取的 PE 资源同源），
      改一处即 ①③ 同时生效。
    -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    包版本固定，不用通配符 "*"：
    "*" 会让每次还原拉到不同的上游版本，构建不可复现，也让实测结论随时间失效。

    Microsoft.Windows.SDK.BuildTools 不在此显式声明：
    WindowsAppSDK 依赖链会带上它（并要求 10.0.26100.4654），手写旧版会触发 NU1605 降级冲突。
    该包是 NuGet 包，自带工具链，不要求本机安装同版本 Windows SDK。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      引用 Core（设计文档 §2.1 分层：Ui → Engine → Input，Core 被 Host 与 Host.Tests 共用）。
      任务模型、校验器、键目录、配置契约、以及输入层的纯逻辑（InputSimulator / HoldTable）
      全部在 Core；Host 只放平台相关的薄适配（SendInputSink / HookService）。
    -->
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <!--
    应用图标（占位资产）的复制语义。

    同一个文件会被三条路径重复纳入，必须去重，否则发布的复制链路整组失效：
      ① SDK 默认 None 通配：`<None Include="**/*" />` 覆盖 *.ico（Microsoft.NET.Sdk.DefaultItems.props）
      ② Microsoft.WinUI.props 的 `<Content Include="Assets/**/*.*" />`（不带任何复制元数据）
      ③ 下方本项目的显式 Content 项（带复制元数据）
    三者 TargetPath 相同但元数据不同，ResolveOverlappingItemGroupConflicts 的 Distinct() 去不掉，
    结果 ResolvedFileToPublish 里同一文件出现三次，下游 _SplitResolvedFileToPublishItems 的
    条件匹配失效 → _CopyResolvedFilesToPublishPreserveNewest 为空 → publish 产物无 Assets 目录。
    而窗口图标（MainWindow）与托盘图标（TrayIcon）都改从 exe 的 PE 资源取，
    不再依赖产物目录里存在 Assets\ —— 发布产物无该目录也不影响显示（旧版按
    文件路径取图标曾因此退回默认图标）。

    处理：①③ 各自排除该文件，只留下方唯一一条带复制元数据的显式 Content 项。
    占位说明（为何不靠通配符）：Assets 目录下除 AppIcon.ico 外不放任何文件——
    任何新增文件都会重新引入通配符条件匹配问题，此处不再单独维护说明文档。
  -->
  <ItemGroup>
    <None Remove="Assets\AppIcon.ico" />
    <Content Remove="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <!-- TargetPath 必须显式给出：缺省时该项的 TargetPath 为空串。 -->
      <TargetPath>Assets\AppIcon.ico</TargetPath>
    </Content>
  </ItemGroup>
</Project>