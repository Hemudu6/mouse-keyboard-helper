<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Host.Views.TaskListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Host.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        任务列表页（设计文档 §6.1 第一行）。

        页面结构：顶部操作条（新建 / 停止全部任务）+ 载入异常提示 + 任务卡片列表。
        卡片用 ItemsControl 而非 ListView：本页**没有"选中一行"的语义**——
        每个卡片自带编辑 / 复制 / 删除按钮，选中态只会带来"选中了但什么也没发生"的困惑。

        状态标识（运行中 / 已停止）由 RunStateChanged 驱动重读，不轮询（§6.5.3）。
    -->
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作条 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="NewTaskButton"
                Grid.Column="0"
                Click="OnNewTaskClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="新建任务" />
                </StackPanel>
            </Button>

            <!--
                「停止全部任务」(FR-RUN-04)：与托盘的「停止全部」同一条语义
                （Scheduler.StopAll），只是入口不同——两者都**不退出进程**（§6.3）。
            -->
            <Button
                x:Name="StopAllButton"
                Grid.Column="1"
                Click="OnStopAllClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                    <TextBlock Text="停止全部任务" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 载入配置时的问题提示（AC-37：不静默）-->
        <InfoBar
            x:Name="LoadNoticeBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning"
            Title="配置载入提示" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <!-- 空列表提示：不显示空白区域，告诉用户下一步做什么 -->
                <TextBlock
                    x:Name="EmptyHint"
                    Margin="4,24"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="还没有任务。点击「新建任务」开始。"
                    Visibility="Collapsed" />

                <ItemsControl x:Name="TaskList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:TaskListEntry">
                            <Border
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <!-- 任务名 -->
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />

                                        <!-- 开关按键 + 状态标识 -->
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ToggleKeyText}" />

                                            <Border
                                                Padding="8,2"
                                                Background="{x:Bind StateBackground, Mode=OneWay}"
                                                CornerRadius="10">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse
                                                        Width="7"
                                                        Height="7"
                                                        VerticalAlignment="Center"
                                                        Fill="{x:Bind StateDot, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Text="{x:Bind StateText, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>

                                            <!--
                                                禁用的任务（FR-TASK-07 / AC-02）单独标一枚：
                                                它的开关键点了没反应，界面上必须让人看得出为什么。
                                            -->
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="已禁用"
                                                Visibility="{x:Bind DisabledBadgeVisibility}" />
                                        </StackPanel>

                                        <!-- 命令摘要 -->
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind CommandsText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- 卡片操作 -->
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <ToggleSwitch
                                            Header="启用"
                                            IsOn="{x:Bind Enabled, Mode=OneWay}"
                                            MinWidth="0"
                                            Tag="{x:Bind Id}"
                                            Toggled="OnEnabledToggled" />

                                        <Button
                                            Click="OnEditTaskClick"
                                            Content="编辑"
                                            Tag="{x:Bind Id}" />
                                        <Button
                                            Click="OnDuplicateTaskClick"
                                            Content="复制"
                                            Tag="{x:Bind Id}" />
                                        <Button
                                            Click="OnDeleteTaskClick"
                                            Content="删除"
                                            Tag="{x:Bind Id}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
