<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Host.Views.TaskEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Host.Views"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="编辑任务" Style="{StaticResource TitleTextBlockStyle}" />

        <!--
            非阻断提示条（设计文档 §5.2）：裸键开关键属「合法但易误触」，提示不阻保存，
            因此不能用 ContentDialog（那会把用户按在原地等一个「知道了」）。
        -->
        <InfoBar
            x:Name="BareKeyHintBar"
            Grid.Row="1"
            Severity="Informational"
            IsOpen="False"
            IsClosable="True" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <Border
                    CornerRadius="8"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="基本信息" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <TextBox x:Name="NameBox" Header="任务名称" PlaceholderText="请输入任务名称" />

                        <ToggleSwitch
                            x:Name="EnabledSwitch"
                            Header="启用"
                            OffContent="停用"
                            OnContent="启用" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="开关按键" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBox
                                    x:Name="ToggleKeyBox"
                                    IsReadOnly="True"
                                    Width="220"
                                    PlaceholderText="（未设置）" />
                                <Button x:Name="CaptureToggleKeyButton" Content="捕获按键" />
                                <Button x:Name="ResetToggleKeyButton" Content="恢复默认" />
                            </StackPanel>
                            <ProgressRing x:Name="ToggleKeyRing" IsActive="False" Width="20" Height="20" />
                        </StackPanel>

                        <CheckBox
                            x:Name="ConsumeToggleInputCheck"
                            Content="消费开关按键（按下时不再传给其他程序）" />
                    </StackPanel>
                </Border>

                <Border
                    CornerRadius="8"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                            <TextBlock Text="命令" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Button x:Name="AddCommandButton" Content="添加命令" />
                        </StackPanel>

                        <TextBlock x:Name="EmptyCommandHint" Text="暂无命令，点击「添加命令」新增一条。" />

                        <ItemsControl x:Name="CommandList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:CommandRow">
                                    <Border
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,12"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox
                                                    Grid.Column="0"
                                                    Header="类型"
                                                    HorizontalAlignment="Stretch"
                                                    SelectedIndex="{x:Bind KindIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="键盘单键" />
                                                    <ComboBoxItem Content="键盘组合键" />
                                                    <ComboBoxItem Content="鼠标移动" />
                                                    <ComboBoxItem Content="鼠标按键" />
                                                    <ComboBoxItem Content="鼠标滚轮" />
                                                </ComboBox>
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Header="点按方式"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="{x:Bind TapModeApplies, Mode=OneWay}"
                                                    SelectedIndex="{x:Bind TapModeIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="单次点按" />
                                                    <ComboBoxItem Content="按住" />
                                                    <ComboBoxItem Content="不适用" />
                                                </ComboBox>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="删除"
                                                    VerticalAlignment="Bottom"
                                                    Click="OnDeleteCommandClick" />
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <NumberBox
                                                    Header="频率（次/秒）"
                                                    Width="160"
                                                    Minimum="{x:Bind local:CommandRow.MinFrequency}"
                                                    Maximum="{x:Bind local:CommandRow.MaxFrequency}"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="{x:Bind Frequency, Mode=TwoWay}" />
                                            </StackPanel>

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Visibility="{x:Bind IsKeyboard, Mode=OneWay}">
                                                <ComboBox
                                                    Header="按键"
                                                    Width="200"
                                                    SelectedIndex="{x:Bind KeyboardKeyIndex, Mode=TwoWay}"
                                                    ItemsSource="{x:Bind KeyboardKeyItems}" />
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Bottom"
                                                    Visibility="{x:Bind IsCombo, Mode=OneWay}">
                                                    <CheckBox Content="Ctrl" IsChecked="{x:Bind UseCtrl, Mode=TwoWay}" />
                                                    <CheckBox Content="Alt" IsChecked="{x:Bind UseAlt, Mode=TwoWay}" />
                                                    <CheckBox Content="Shift" IsChecked="{x:Bind UseShift, Mode=TwoWay}" />
                                                    <CheckBox Content="Win" IsChecked="{x:Bind UseWin, Mode=TwoWay}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Visibility="{x:Bind IsMouseMove, Mode=OneWay}">
                                                <NumberBox
                                                    Header="X 偏移"
                                                    Width="140"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="{x:Bind X, Mode=TwoWay}" />
                                                <NumberBox
                                                    Header="Y 偏移"
                                                    Width="140"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="{x:Bind Y, Mode=TwoWay}" />
                                            </StackPanel>

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Visibility="{x:Bind IsMouseButton, Mode=OneWay}">
                                                <ComboBox
                                                    Header="鼠标按键"
                                                    Width="200"
                                                    SelectedIndex="{x:Bind MouseButtonIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="左键" />
                                                    <ComboBoxItem Content="右键" />
                                                    <ComboBoxItem Content="中键" />
                                                    <ComboBoxItem Content="侧键 X1" />
                                                    <ComboBoxItem Content="侧键 X2" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Visibility="{x:Bind IsMouseScroll, Mode=OneWay}">
                                                <ComboBox
                                                    Header="滚动方向"
                                                    Width="200"
                                                    SelectedIndex="{x:Bind ScrollDirectionIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="向上" />
                                                    <ComboBoxItem Content="向下" />
                                                </ComboBox>
                                                <NumberBox
                                                    Header="滚动格数"
                                                    Width="140"
                                                    Minimum="1"
                                                    Maximum="{x:Bind local:CommandRow.MaxScrollNotches}"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="{x:Bind Notches, Mode=TwoWay}" />
                                            </StackPanel>

                                            <TextBlock
                                                Text="{x:Bind Summary, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="12"
            HorizontalAlignment="Right">
            <Button x:Name="SaveTaskButton" Content="保存" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="CancelTaskButton" Content="取消" />
        </StackPanel>
    </Grid>
</Page>
